[0.2,"o","# match_accuracy results\r\n\r\nn = 200 committed trial\u2013publication pairing tasks.\r\n\r\nHeadline non-reporting statistic is defensible on this probe set (MATCH precision 0.962 >= 0.85 and recall 1.000 >= 0.80).\r\n\r\n| metric | value |\r\n| --- | --- |\r\n| n pairs | 200 |\r\n| MATCH precision | 0.962 |\r\n| MATCH recall | 1.000 |\r\n| MATCH F1 | 0.980 |\r\n| decision accuracy | 0.980 |\r\n| link accuracy | pred MATCH | 1.000 |\r\n| AMBIGUOUS accuracy | 0.900 |\r\n| headline defensible | yes |\r\n\r\n| cohort | n | MATCH | NO_MATCH | AMBIGUOUS |\r\n| --- | --- | --- | --- | --- |\r\n| ambiguous | 20 | 2 | 0 | 18 |\r\n| date_outside | 20 | 2 | 18 | 0 |\r\n| hard_negative_title | 20 | 0 | 20 | 0 |\r\n| hard_positive | 20 | 20 | 0 | 0 |\r\n| nct_easy | 40 | 40 | 0 | 0 |\r\n| title_pi_date | 40 | 40 | 0 | 0 |\r\n| true_unmatched | 40 | 0 | 40 | 0 |\r\n\r\n"]
